%% ABBREVIATIONS
\newcommand{\bve}[0]{\textsc{bve}}                               % Dutch: behoud van energie
\newcommand{\bvm}[0]{\textsc{bvm}}                               % Dutch: behoud van massa
\newcommand{\bvme}[0]{\textsc{bvme}}                             % Dutch: balans van mechanische energie
\newcommand{\cte}[0]{\up{c^{te}}}                                % constant
\newcommand{\CV}[0]{\up{cv}}                                     % control volume
\newcommand{\dutch}[1]{[Dutch: {#1}]}                            % to add Dutch translation
\newcommand{\english}[1]{[Engels: {#1}]}                         % to add English translation
\newcommand{\pv}[0]{$\pres\vol$-diagram}                         % pressure volume diagram
\newcommand{\ph}[0]{$\pres h$-diagram}                           % pressure enthalpy diagram
\newcommand{\ts}[0]{$T\!s$-diagram}                              % temperature entropy diagram
\newcommand{\TikZ}[0]{Ti\textit{k}Z}                             % to typeset the acronym TikZ
\newcommand{\units}[1]{\quad\left[\unit{#1}\right]}              % to add [unit] after equation, using \unit
\newcommand{\unitschart}[1]{\;\left[\unit{#1}\right]}            % to add [unit] on axis, using \unit
\newcommand{\ud}[0]{\up{d}}                                      % differential operator
\newcommand{\up}[1]{\mathrm{#1}}                                 % to write upright math, shorter version of \mathrm

%% BEAMER
% chapters exist in class memoir but not in class beamer
% that's why we made a new command \chapterOrPart that will start a new chapter in memoir
% but in beamer, it will not start a new chapter but a new part
\newcommand\chapterOrPart[1]{
	\only<article>{\chapter{#1}}   % define new chapter, when using class memoir
	\only<presentation>{\part{#1}} % define new part, when using class beamer, because chapters do not exist in beamer
	\mode*}                        % \mode* = neglect all content that is not inside frame environments in beamer
\newcommand{\vspacebeamer}[1][0.5cm]{\only<presentation>{\vspace{#1}}} % add vertical space in beamer, default is 0.5cm
\newcommand\textbeamer[4]{\only<presentation>{\begin{textblock*}{#1}(#2,#3)\small #4\end{textblock*}}}
\newcommand\frameVisible[0]{\iftoggle{showResults}{all}{presentation=0}}% to include a slide, only when showResults = TRUE
\newcommand\smallbeamer[0]{\only<presentation>{\small}}                 % set font size to small,        when using beamer, but not in memoir
\newcommand\largebeamer[0]{\only<presentation>{\large}}                 % set font size to large,        when using beamer, but not in memoir
\newcommand\Largebeamer[0]{\only<presentation>{\Large}}                 % set font size to Large,        when using beamer, but not in memoir
\newcommand\footnotesizebeamer[0]{\only<presentation>{{\footnotesize}}} % set font size to footnotesize, when using beamer, but not in memoir
\newcommand\scriptsizebeamer[0]{\only<presentation>{\scriptsize}}       % set font size to scriptsize,   when using beamer, but not in memoir
\newcommand\tinybeamer[0]{\only<presentation>{\tiny}}                   % set font size to tiny,         when using beamer, but not in memoir

