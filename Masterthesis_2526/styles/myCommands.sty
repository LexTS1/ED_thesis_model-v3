\newcommand{\normaldensityvalue}[0]{\qty{1.29}{\kg/{N\cubic\m}}}           % normal density air
\newcommand{\rhowatervalue}[0]{\qty{1000}{\kg\per\cubic\m}}                % density liquid water
\newcommand{\Runivvalue}[0]{\qty{8.31}{\J\per\mole\per\K}}                 % universal gas constant
