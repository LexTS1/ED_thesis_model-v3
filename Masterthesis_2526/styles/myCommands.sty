%% NOMENCLATURE
% the command \IfLanguageName will add entries in the nomenclature in English or Dutch,
% depending on the document language
\IfLanguageName{english} % 
    { % write explanations in English in nomenclature = use #3
        \newcommand{\acronym}[3]{#1 & #3 \\} % #3 = English explanation
        \newcommand{\dimensionlessnumber}[4]{$\up{#1}$ & #3 & $#4$\\}
        \newcommand{\nomenclature}[4]{$#1$ & #3 & \unit[per-mode=symbol]{#4}\\} % symbol, ENG, unit
        %\newcommand{\nomenclature}[4]{$#1$ & #3 & $\up{#4}$\\} % symbol, ENG, unit
        \newcommand{\nomenclaturesubscript}[3]{#1 & #3\\}
    } 
    { % write explanations in Dutch in nomenclature = use #2
        \newcommand{\acronym}[3]{#1 & #2 \\} % #2 = Dutch explanation
        \newcommand{\dimensionlessnumber}[4]{$\up{#1}$ & #2 & $#4$\\}
        \newcommand{\nomenclature}[4]{$#1$ & #2 & \unit[per-mode=symbol]{#4}\\} % symbol, DUTCH, unit
        \newcommand{\nomenclaturesubscript}[3]{#1 & #2\\}
    }

%% SYMBOLS
% Using commands for frequently used symbols in your thesis offers two significant advantages:
%  1 Employing custom commands ensures the consistent usage of the same symbol throughout your thesis
%  2 If it is required to modify a symbol across your entire document, you can achieve this effortlessly
%    by modifying the definition within the \newcommand
\newcommand{\abshum}[0]{\ensuremath{x}}                % absolute humidity
\newcommand{\cv}[0]{\ensuremath{c_v}}                  % specific heat capacity at cte volume
\newcommand{\cp}[0]{\ensuremath{c_p}}                  % specific heat capacity at cte pressure
\newcommand{\hevap}[0]{\Delta h_\up{evap}}             % enthalpy of evaporation
\newcommand{\masf}[0]{\ensuremath{y}}                  % mass fraction 
\newcommand{\mdot}[0]{\ensuremath{\dot{m}}}            % mass flow rate 
\newcommand{\molf}[0]{\ensuremath{Y}}                  % mole fraction 
\newcommand{\pres}[0]{\ensuremath{p}}                  % pressure 
\newcommand{\psat}[0]{\ensuremath{\pres_\up{sat}}}     % saturation pressure
\newcommand{\qdot}[0]{\ensuremath{\dot{Q}}}            % thermal power
\newcommand{\relhum}[0]{\ensuremath{\varphi}}          % relative humidity
\newcommand{\rpm}[0]{$\ensuremath{N}$}                 % rotaional speed
\newcommand{\thermcond}[0]{\ensuremath{\lambda}}       % thermal conductivity
\newcommand{\vdot}[0]{\ensuremath{\dot{\mathcal{V}}}}  % volume flow rate
\newcommand{\vel}[0]{\ensuremath{V}}                   % velocity
\newcommand{\vol}[0]{\ensuremath{\mathcal{V}}}         % volume
\newcommand{\specvol}[0]{\ensuremath{{v}}}             % specific volume
\newcommand{\tdb}[0]{\ensuremath{T_\up{DB}}}           % dry bulb temperature
\newcommand{\tnb}[0]{\ensuremath{T_\up{NB}}}           % wet bulb temperature
\newcommand{\viscodyn}[0]{\ensuremath{\mu}}            % dynamic viscosity
\newcommand{\viscokin}[0]{\ensuremath{\nu}}            % kinematic viscosity
\newcommand{\wdot}[0]{\ensuremath{\dot{W}}}            % mechanical power
\newcommand{\Nusselt}[0]{\up{N\!u}}                    % Nusselt number
\newcommand{\Prandtl}[0]{\up{Pr}}                      % Prandtl number
\newcommand{\Reynolds}[0]{\up{Re}}                     % Reynolds number

