\usepackage[
  backend=biber,
  style=numeric,
  citestyle=numeric,
  sorting=none
]{biblatex}
    
\DeclareNameAlias{sortname}{family-given}        % authors in bibliography formatted as: surname, initials
%\renewcommand{\mkbibnamefamily}[1]{\textsc{#1}} % surname in all caps in bibliography

% if more than one bib file, load them separately
\addbibresource{bib/myBibliography.bib}          % my bibliography
