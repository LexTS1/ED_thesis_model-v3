% This is a style file for adding your own environments

% set style for \newtheorem to style that emphasizes definitions
\theoremstyle{definition}   % more info at ctan.org/pkg/amsthm

% environment for calculation example
\newcounter{example} % used as counter in the calculation examples
\newenvironment{calculationexample}[1] {\refstepcounter{example}\par\medskip\noindent\color{brown}\textbf{Example~\theexample:~#1}\par}{}%\smallskip}

% environment for solution of calculation example
\newenvironment{Solution}
{	\color{blue}}
{	\par
	%\tikz{\draw [pin](0,0) -- ++(\textwidth,0) -- ++(0,0.1cm)}
}

% environment for dense item list
\newenvironment{itemshort}
    {\begin{itemize} \setlength{\itemsep}{-0.10cm}}
    {\end{itemize}}

% environment for dense numbered list
\newenvironment{enumerateshort}
    {\begin{enumerate} \setlength{\itemsep}{-0.10cm}}
    {\end{enumerate}}

% environment for explanations at start of chapters
\newenvironment{explanation}
     {\begin{quote}\itshape\color{blue}}
     {\par Do not forget to remove all explanations in blue from your final document. This can be achieved by uncommenting the line \cs{hideExplanations} in your main file.\end{quote}\ignorespacesafterend}

% command to automatically hide all the explanations in blue at the start of chapters
% this is achieved in two steps, see section 15.2 in ctan.org/pkg/memoir for more info
\newcommand{\hideExplanations}[0]{ % command to hide explanations in blue at the start of chapters
\newcomment{explanation}           % step 1) redefine the previously defined explanation environment as a comment environment
\commentson{explanation}}          % step 2) switch it on, so its content will no longer appear in the PDF