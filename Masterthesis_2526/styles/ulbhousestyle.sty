% coulours
\definecolor{ULBblue}{rgb}{0,0.2196,0.5765} % change definition if wanted

% BRUFACE title page
\newcommand\maketitleBRUFACE{ 
    \begin{titlingpage}
    \begin{tikzpicture}[remember picture,overlay,font=\sffamily\Large] % text width=15cm
        \tikzstyle{every node}=[below right];
        \node [xshift= 4mm,yshift= -21mm,below,align=center] at (current page.north)                 {\logobruface}; % Bruface logo
        \node [xshift= 4cm,yshift=-12cm] at (current page.north west) (T) [ULBblue, text width=14cm] {\LARGE\brufacetitle};
        \node [yshift= 1cm]   at (T.north west) [above right,text width=14cm]                        {\brufacepretitle};
        \node [yshift=-0.2cm] at (T.south west) (S) [ULBblue,text width=14cm]                        {\brufacesubtitle}; 
        \node [yshift=-2.0cm]   at (S.south west) (A)                                                  {\bfseries\brufacestudent}; 
        \node [xshift=4cm,yshift=4cm]  at (current page.south west) (Y)[ULBblue]                     {\large Academic year};
        \node at (Y.south west) {\brufaceyear}; 
        \node [xshift=-2cm,yshift=6cm] at (current page.south east) (P)[ULBblue,left] {\large\brufacetypeofwork};
        \node at (P.south west) {\brufacesupervisors}; 
        \node [yshift=-2cm] at (P.west) (D) [ULBblue]{\large\brufacedegree};
        \node at (D.south west) [align=left]{\brufaceprogram}; 
        \draw[ULBblue,thick] (T.north west) ++(-0.5,1)    -- +(0,-8); % vertical line
        \draw[ULBblue,thick] (S.south west) ++(-0.5,-0.5) -- +(14,0); % horizontal line
    \end{tikzpicture}
\end{titlingpage}}

