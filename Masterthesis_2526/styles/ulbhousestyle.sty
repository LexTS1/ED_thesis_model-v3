% This style file sets the ULB house style (BRUFACE and non-BRUFACE)

% logos

\newcommand{\logobruface}       {\includegraphics[height = 3cm ] {figs/logoBRUFACE}}
\newcommand{\logobrufaceslide}  {\includegraphics[width  = 5cm ] {figs/logoBRUFACE}}
\newcommand{\logopolytech}      {\includegraphics[scale  = 0.35] {figs/logo_polytech_FR.pdf}}
\newcommand{\logopolytechslide} {\includegraphics[width  = 5cm ] {figs/logo_polytech_FR.pdf}}
\newcommand{\logoulb}           {\includegraphics[scale  = 1.1 ] {figs/logo_ULB2.pdf}}
