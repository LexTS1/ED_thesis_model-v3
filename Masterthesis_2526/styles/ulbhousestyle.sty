% BRUFACE title slide
\newcommand\maketitleslideBRUFACE{ 
\begin{frame}[noframenumbering,plain]
    \def\leftindent{2cm}
    \begin{tikzpicture}[remember picture,overlay,text width=9.5cm]
        \node [xshift= 0mm,yshift= -5mm,below,align=center] at (current page.north)                 {\logobrufaceslide};
        \tikzstyle{every node}=[below right,font=\normalsize] 
        \node[xshift=\leftindent, yshift= -3.5cm,text width=10cm] at (current page.north west) (title) [ULBblue,font=\large] {\brufacetitle};
        \node[yshift=   0cm,above right] at (title.north west)[font=\scriptsize] {\brufacepretitle}; % uncomment to see the pretitle
        \node[yshift=  -0.0cm] at (title.south west) [ULBblue][font=\scriptsize] {\brufacesubtitle}; 
        \node[yshift=  -1.0cm] at (title.south west) {\brufacestudent};
        \node[yshift=  -1.7cm] at (title.south west) {\brufacepresentationdate};
        \node[yshift=   1.5cm, xshift=\leftindent] at (current page.south west) (Y)[ULBblue] {Supervision: \brufacesupervisors};
    \end{tikzpicture}
\end{frame}}

% ULB title slide
\newcommand\maketitleslideULB{ 
\begin{frame}[noframenumbering,plain]
    \def\leftindent{2cm}
    \begin{tikzpicture}[remember picture,overlay,text width=9.5cm]
        \node [xshift= 0mm, yshift= -5mm,below,align=center] at (current page.north){\logopolytechslide};
        \node [xshift= -10mm,yshift= -5mm,below,align=center] at (current page.north east){\logoulbslide};
        \tikzstyle{every node}=[below right,font=\normalsize] 
        \node[xshift=\leftindent, yshift= -3.5cm,text width=10cm] at (current page.north west) (title) [ULBblue,font=\large] {\ulbtitleA\\ \ulbtitleB};
        \node[yshift=  -0.0cm] at (title.south west) [ULBblue,font=\scriptsize] {\ulbsubtitle}; 
        \node[yshift=  -1.0cm] at (title.south west) {\ulbstudent};
        \node[yshift=  -1.7cm] at (title.south west) {\ulbpresentationdate};
        \node[xshift=\leftindent,yshift=   1.0cm] at (current page.south west) (faculty) [] {\textcolor{ULBblue}{Service:} \ulbdept};
        \node[yshift=   0.5cm] at (faculty.north west) [] {\textcolor{ULBblue}{Superviseur:} \ulbsupervisor};
    \end{tikzpicture}
\end{frame}}
