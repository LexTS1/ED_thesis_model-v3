% This is a style file for adding your own drawing related commands (TikZ + plotting)

% flows and vectors
\tikzstyle{mass}      = [>=latex,color=blue,   thick] % mass flows
\tikzstyle{heat}      = [>=latex,color=red,    thick] % heat flows
\tikzstyle{cold}      = [>=latex,color=cyan,   thick] % cold flows
\tikzstyle{work}      = [>=latex,color=olive,  thick] % work flows
\tikzstyle{force}     = [>=latex,color=magenta,thin]  % force vector
\tikzstyle{torque}    = [>=latex,color=brown,  thin]  % torque vector
\tikzstyle{rotation}  = [>=latex,color=olive,  thin]  % rotation velocity
\tikzstyle{absolute}  = [>=latex,color=blue,   thin]  % absolute velocity
\tikzstyle{relative}  = [>=latex,color=red,    thin]  % relative velocity

% helping lines
\tikzstyle{axis}      = [densely dashed,gray,font=\small]
\tikzstyle{centerline}= [dashed,ultra thin,dash pattern=on 8pt off 1pt on 2pt off 1pt]
\tikzstyle{measure}   = [>=latex,color=black, ultra thin]  % measure
\tikzstyle{pin}       = [color=blue,ultra thin]            % name pin
\tikzstyle{helpline}  = [color=gray,dashed,ultra thin]     % help lines
\tikzstyle{angle}     = [>=latex,thin,font=\small]         % angle arc
\tikzstyle{cv}        = [color=red,dashed]                 % control volume

% objects
\tikzstyle{blade}     = [thick]                            % blade in a pump
\tikzstyle{process}   = [color=black,thick]                % process
\tikzstyle{system}    = [cv,fill=blue!05]                  % system
\tikzstyle{component} = [color=black!60,fill=white,thick]  % component

%% arrows on lines
\tikzstyle{deco}= [decoration={markings,mark=at position #1 with {\arrow[scale=1.2]{>}}}, >=stealth, postaction={decorate}] % to put an arrow somewhere on a line
\tikzstyle{decoinvers}= [decoration={markings,mark=at position #1 with {\arrow[scale=1.2]{<}}}, >=stealth, postaction={decorate}] % to put an inverted arrow somewhere on a line

% block diagram styles
\tikzstyle{block}       = [draw=VUBblue, rectangle, rounded corners, font=\footnotesize, text=black, align=center,minimum height=1cm, minimum width=2cm] % generic block
\tikzstyle{model}       = [block,very thick]        % model block
\tikzstyle{kpi}         = [block,fill=VUBblue!03]   % key performance indicator block
\tikzstyle{connectline} = [draw=VUBorange,deco=0.6] % connector between blocks 

% HVAC styles
\tikzset{SHF/.style={color=brown,thick}}    % sensible heat factor
\tikzset{cooling/.style={color=blue,thick}} % cooling process on psychrometric chart
\tikzset{heating/.style={color=red,thick}}  % heating process on psychrometric chart

% circuitikz definitions
\def\killdepth#1{{\raisebox{0pt}[\height][0pt]{#1}}} % p. 24 texdoc.org/serve/circuitikzmanual.pdf/0

\def\normalcoord(#1){coordinate(#1)} % p. 24 texdoc.org/serve/circuitikzmanual.pdf/0
\def\showcoord(#1){coordinate(#1) node[circle, red, draw, inner sep=1pt,
pin={[red, overlay, inner sep=0.5pt, font=\tiny, pin distance=0.1cm,
pin edge={red, overlay}]45:#1}](){}}
\let\coord=\normalcoord
\let\coord=\showcoord

% function to calculate the absolute humidity
\tikzset{declare function=
    {calculateabshum(\t,\rh)
    = \rh*10*(1.0899E-8*\t^4-3.2124E-7*\t^3+1.6124E-5*\t^2+3.0269E-4*\t+3.3145E-3);}}

% function to calculate the relative humidity
\tikzset{declare function=
    {calculateRH(\t,\rh)
    = \rh*10*(1.0899E-8*\t^4-3.2124E-7*\t^3+1.6124E-5*\t^2+3.0269E-4*\t+3.3145E-3);}}

% draw drying process on psychrometric chart
\newcommand{\drawdryinginpsychro}[2]{
	\addplot [cooling,mark=none,domain=#2:#1,decoinvers=0.5] {1000*(1.0899E-8*x^4-3.2124E-7*x^3+1.6124E-5*x^2+3.0269E-4*x+3.3145E-3)};
}

% draw saturation line on psychrometric chart
\newcommand{\drawsaturationline}[1]{
    \addplot [color=blue,mark=none,domain=-10:34]
    {calculateRH(x,100)} node[left] {#1};
}

% draw markers
\newcommand{\drawdot}[1]{% draw marker at coordinate #1
	\node[mark=*,mark size=1.5pt,color=orange] at (#1)
	{\pgfuseplotmark{*}};
}
\newcommand{\drawdotwithtext}[3]{% draw marker + text at coordinate #1
	\node[mark=*,mark size=1.5pt,color=orange] at (#1) {\pgfuseplotmark{*}};
	\node[#2] at (axis cs:#1){#3};
}

% set axes styles
\pgfplotsset{axespsychro/.style= % chart settings for a psychrometric chart
	{scale only axis,
		%	enlarge x limits=-1,
		width=9cm,
		height=5cm, % because beamer slide is 9.6 cm high and 1.5 cm for title and 1.5 cm for caption is needed
		axis x line=left, % only x axis, no box
		axis y line=right, % only y axis, no box
		ymin=0.0, ymax=38, % x
		xmin=-6, xmax =50, % TDB
		xlabel={$T_\up{DB}\unitschart{\si{\celsius}}$},
		ylabel={$x\unitschart{\si{g_{vapour}\per kg_{dry air}}}$},
	}}

% draw centrifugal pump
\newcommand{\drawcentrifugalpumpcircles}[2]{
    % draw centrifugal pump blade with the following parameters:
    % 1: inner radius of pump
    % 2: outer radius of pump
	\draw (0,0) circle [radius=#1]; % pump inlet
    \draw (0,0) circle [radius=#2]; % pump outlet
    \draw[angle,->] (60:1.1*#2) arc (60:40:1.1*#2) node[pos=0.7, above right] {$\dot{\omega}$}; % rotation direction
    \draw [centerline] (-1.1*#2,0) -- (1.1*#2,0); % horizontal centerline
    \draw [centerline] (0,-1.1*#2) -- (0,1.1*#2); % vertical centerline
}

% draw centrifugal pump impeller blade
\newcommand{\drawcentrifugalpumpblade}[6]{
    % draw pump blade with the following parameters:
    % 1: inner radius of pump
    % 2: outer radius of pump
    % 3: angle of root of blade
    % 4: angle of curve of blade
    % 5: angle beta 1 of blade
    % 6: angle beta 2 of blade
	\coordinate (root) at (#3:#1);
    \coordinate (tip) at (#3+#4:#2);
     %\draw [blade] (root) to [out=180-#5+#3,in=#4-#6+#3] (tip);
    \draw [blade] (root) to [out=90-#5+#3, in=#3+#4-#6-90] (tip);
     % \draw ($(root)+(90-#5+#3:0.3)$) arc (90-#5+#3:93+#3:0.3) node[pos=0.5, above] {$\beta_1$}; %
}

% draw angle
\newcommand{\drawangle}[7]{
    % draw an arc to indicate an angle with the following parameters:
    % 1: coordinate of center of arc
    % 2: angle of direction 1
    % 3: angle of direction 2
    % 4: name of label
    % 5: radius of arc
    % 6: position of label along arc  (between 0 and 1)
    % 7: position of label relative to arc (left, right, ...)
    \draw [axis] (#1) -- +({#2}:{#5}) coordinate (anglestart) -- +({#2}:{1.2*#5}); % draw axis of direction 1
    \draw [axis] (#1) -- +({#3}:{1.2*#5}); % draw axis of direction 2
    \draw[angle,->,shorten >=0.5pt] (anglestart) arc ({#2}:{#3}:{#5}) node[pos=#6,#7] {#4}; % draw arc arrow
}

% draw a pump icon
\newcommand{\drawpumpicon}[3]{
    % draw a pump icon with the following parameters:
    % 1: x coordinate
    % 2: y coordinate
    % 3: name tag
	\def\Rpump{0.3} % radius of circle in icon
	\draw [component] (#1,#2) rectangle +(-0.5,\Rpump);
	\draw [component] (#1,#2) circle (\Rpump);
	\node at (#1,#2+\Rpump) [above] {#3};
	\draw [work,->] (#1,#2-0.7) node [below] {$\wdot_\text{#3}$}-- +(0,0.4) 
}

\newcommand{\drawtarget}[1]{
   \foreach \X in {0.25,1,1.75}
     {\draw[blue] (0,0) circle (\X);}
     \node[anchor=north] at (-90:1.8) {#1};
}

\newcommand{\drawshots}[2]{
\foreach \X in {1,...,40} % 40 shots
      \fill[red] (#1,#1) + (rand*360:rand*#2) circle(0.8pt)
}     