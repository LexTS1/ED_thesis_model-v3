% This style file loads some useful packages
% The packages are alphabetically grouped by these topics:
%    debugging, figures, language, math & science,
%    referring, tables, units, watermark


%% DEBUGGING
\usepackage{layout}                  % provides \layout to show layout lengths
\setlength{\marginparwidth}{2cm}     % to avoid warning about todonotes
\usepackage[colorinlistoftodos,      % add margin note with \todo{note text}
            color=green!40,          % color of margin note
            bordercolor=white,       % color of margin note border
            prependcaption,
            figwidth=0.5\linewidth,  % width of missing figure placeholder 
            textsize=footnotesize]   % font size of note
            {todonotes}              % to add margin note with \todo{note text}
%\usepackage[disable]{todonotes}     % hide all annotations
%\usepackage[texcoord,grid,gridcolor=red!10,subgridcolor=green!10,gridunit=cm]{eso-pic} % add grid in background
\usepackage{kantlipsum}              % paragraphs of nonsense in Kantian style, eg \kant[1-2]
\usepackage{silence}                 % hide unwanted warnings, ctan.org/pkg/silence
\WarningFilter{latexfont}{Font shape}% hide 'font shape...' warning
\WarningFilter{latexfont}{Some font} % hide 'Some font ...' warning

%% FIGURES
\usepackage{wrapfig}                             % wrap text around figs
%\usepackage{float}                              % float placement
\usepackage[final]{pdfpages}                     % insert pdf documents
\usepackage{tikz,pgfplots,pgfmath}               % for drawings/plots, loads package graphicx
\usepackage{svg}                                 % to include svg files with \includesvg{filename.svg}
\pgfplotsset{compat=1.14}                        % backwards compatibility
\usepgfplotslibrary{groupplots,units}            % to make groupplots, nice units
\usetikzlibrary{                                 % several libraries that extent the functionally of TikZ
    math,positioning,intersections,shapes.misc,
    shapes.geometric,fit,arrows,arrows.meta,
    decorations.pathmorphing,decorations.pathreplacing,
    decorations.shapes,decorations.markings,patterns,
    calc,shadings,dateplot,scopes
} 
\usepackage{circuitikz}                          % to draw electric circuits


%% LANGUAGE
%\usepackage[utf8]{inputenc}           % for writing: ë, é,... no longer required?
\usepackage{eurosym}                  % \euro symbol in text mode, see: www.theiling.de/eurosym
\usepackage{babel}                    % set the document language, language specified in \documentclass
                                      % english will produce: contents chapter figure table
                                      % dutch will produce: inhoudsopgave hoofdstuk figuur tabel
\usepackage{iflang}                   % to check the language, eg english or dutch
\usepackage{csquotes}                 % format quotes, according the document language
\usepackage[T1]{fontenc}              % accents, hyphenation, see: ctan.org/pkg/fontenc
\usepackage{lmodern}                  % Latin Modern fonts, vector-based
\usepackage{fontawesome}              % font with web-related icons
\usepackage[absolute,overlay]{textpos}% textblocks in beamer, ctan.org/pkg/textpos
\mode<article>{\usepackage{enumitem}} % control layout of list environments, not beamer compatible

%% MATH & SCIENCE
\usepackage{amsfonts,amssymb}        % extra mathematical fonts and symbols
\usepackage{amsthm}                  % advanced theorem environment
\usepackage{calculator}              % to perform calculations
\usepackage{commath}                 % common math things like e.g. \dif x
\usepackage{cancel}                  % to cancel terms in equations, provides \cancel{}
\usepackage{chemformula}             % to write chemical formulas, provides \ch{}
\usepackage{pfdicons}                % shapes for process flow diagrams (PFD, PID)
