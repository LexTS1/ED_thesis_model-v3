%% UNITS
\usepackage[detect-all]{siunitx}                 % to write numbers & units, see ctan.org/pkg/siunitx

% set per-mode, see section 4.10 in user manual
\sisetup{inline-per-mode =fraction}              % write units in your text as fractions
\sisetup{display-per-mode=fraction}              % write units in equations as fractions
%\sisetup{per-mode=power}                        % write all units as powers
%\sisetup{per-mode=fraction}                     % write all units as fractions 
%\sisetup{per-mode=symbol}                       % write all units as symbols 
%\sisetup{range-phrase=--}                       % use -- to indicate a range 
%\sisetup{separate-uncertainty=true}             % use +- to display uncertainties
\sisetup{separate-uncertainty-units=single}      % brackets/single for uncertainty
\sisetup{detect-weight=true, detect-family=true} % use surrounding font to format number + unit

\DeclareSIUnit\year{yr}                          % define unit:        year
\DeclareSIUnit\yr{yr}                            % define unit symbol: yr
\DeclareSIUnit\hour{h}                           % define unit:        hour
\DeclareSIUnit\h{h}                              % define unit symbol: h
\DeclareSIUnit\kWh{kWh}                          % define unit:        kWh
\DeclareSIUnit\kWe{kW_e}                         % define unit:        kW_e
\DeclareSIUnit\MWh{MWh}                          % define unit:        MWh
\DeclareSIUnit\GWh{GWh}                          % define unit:        GWh
\DeclareSIUnit\emission{\!\ch{CO2}eq}            % define unit symbol: CO2eq
                                                 % with negative space to glue it to preceding unit
                                                 
%% WATERMARK
\usepackage[nostamp]{draftwatermark}  % stamp=show watermark, nostamp=hide watermark
\SetWatermarkAngle{60}                % angle
\SetWatermarkLightness{0.9}           % lightness: 0=dark 1=invisible
\SetWatermarkFontSize{3cm}            % font size
\SetWatermarkScale{5}                 % size
\SetWatermarkText{DRAFT}              % eg: DRAFT, CONFIDENTIAL, UNDER NDA






